{
  "name": "carbon-watchdog-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --format codeframe --report-unused-disable-directives --max-warnings 0 '{src,test,bff}/**/*.{js,ts,vue,json,css,md}'",
    "lint:fix": "eslint --format codeframe --report-unused-disable-directives --max-warnings 0 '{src,test,bff}/**/*.{js,ts,vue,json,css,md}' --fix",
    "format": "prettier --config ./.prettierrc --no-editorconfig '{src,test,bff}/**/*.{vue,js,ts,css,json,md}' --check",
    "format:fix": "prettier --config ./.prettierrc --no-editorconfig --ignore-unknown '{src,test,bff}/**/*.{vue,js,ts,css,json,md}' --write",
    "clean": "npm run clean:cache && npm run clean:pack-lock && npm run clean:node_modules",
    "clean:all": "npm run clean && npm run lint:fix && npm run format:fix",
    "clean:cache": "npm cache clean --force",
    "clean:pack-lock": "npx rimraf package-lock.json bun.lock",
    "clean:node_modules": "npx rimraf node_modules",
    "test": "jest --config=jest.config.js",
    "coverage": "jest --config=jest.config.js --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "^1.41.0",
    "@tanstack/vue-form": "^1.33.5",
    "@tanstack/vue-table": "^9.2.4",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "eslint": "^10.10.0",
    "typescript": "^5.9.3"
  }
}
