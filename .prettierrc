{
  "trailingComma": "all",
  "semi": true,
  "singleQuote": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "singleAttributePerLine": true,
  "overrides": [
    {
      "files": [
        "*.md"
      ],
      "options": {
        "tabWidth": 4,
        "singleQuote": false
      }
    }
  ]
}