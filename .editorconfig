# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
quote_type = double

[*.ts]
[*.vue]
[*.json]
[*.jsonc]
[*.css]
[*.scss]
[*.html]
quote_type = single

[*.yml]
[*.yaml]
trim_trailing_whitespace = false

[*.md]
indent_size = 4
max_line_length = off
trim_trailing_whitespace = false
