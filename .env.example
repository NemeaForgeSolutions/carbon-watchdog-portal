# Core API Base URL (defaults to http://localhost:8090)
VITE_API_BASE_URL=http://localhost:8090

# Default Tenant Context
VITE_TENANT_ID=sandbox-demo

# Sandbox Mode (true: offline mock data & mock tokens allowed; false: strict backend & auth)
VITE_SANDBOX_MODE=true

# Zitadel IAM / OIDC Configuration
VITE_ZITADEL_ISSUER=http://localhost:8085
VITE_ZITADEL_CLIENT_ID=carbon-watchdog-portal

# Production Site URL (used for canonical links and Open Graph tags)
VITE_SITE_URL=https://carbonwatchdog.org
